# PostgreSQL connection string.
DATABASE_URL=

# Direct PostgreSQL connection used by Prisma migrations.
DIRECT_URL=

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Canonical application origin, used for cookie and CSRF validation.
APP_URL=http://localhost:3000

NODE_ENV=development
STORAGE_LOCAL_DIR=../timy-local-storage

# Vercel Blob read and write token. Only needed on Vercel.
BLOB_READ_WRITE_TOKEN=

# Development seed only. Use unique local values. Never use these in production.
SEED_STUDENT_EMAIL=
SEED_STUDENT_ID=
SEED_STUDENT_PASSWORD=
SEED_LECTURER_EMAIL=
SEED_LECTURER_ID=
SEED_LECTURER_PASSWORD=
SEED_TIMETABLE_OFFICER_EMAIL=
SEED_TIMETABLE_OFFICER_ID=
SEED_TIMETABLE_OFFICER_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_ID=
SEED_ADMIN_PASSWORD=

LOG_LEVEL=info
